# Webraku::Route — the route table, shared by both halves.
#
# The server matches a request path against it; the browser matches
# `location.pathname` against the same table, built by the same `page` calls in
# the same program, and hydrates the one that answers. One implementation, so
# the two cannot drift apart — which for a framework whose whole claim is that
# the two renders agree is not a small thing.


class Route is export {
    has Str $.kind = 'page';     # 'page' or 'api'
    has Str $.pattern;
    has @.segments;
    has &.body;
    has Str $.title = 'Webraku';

    #| The names of this route's variable segments, in order.
    method param-names() { @!segments.grep(*.starts-with(':')).map(*.substr(1)) }
}

sub split-path(Str $path --> List) is export { $path.split('/').grep(*.chars).List }

#| Match `$path` against `@routes`. Answers (route, params) or (Nil, {}).
sub match-route(@routes, Str $path, Str :$kind --> List) is export {
    my @want = split-path($path);
    for @routes -> $r {
        next if $kind.defined && $r.kind ne $kind;
        my @seg = $r.segments;
        next unless @seg == @want;
        my %params;
        my $ok = True;
        for ^@seg -> $i {
            if @seg[$i].starts-with(':') { %params{@seg[$i].substr(1)} = @want[$i] }
            elsif @seg[$i] ne @want[$i]  { $ok = False; last }
        }
        return ($r, %params) if $ok;
    }
    (Nil, {});
}
# Webraku::JSON — the JSON the framework needs, and no more.
#
# The framework has no dependencies, so it carries its own. It is small on
# purpose: what crosses between the server and the browser is plain data —
# numbers, strings, booleans, arrays, hashes, Nil — which is exactly the
# marshalling table `use JS` states, and exactly what JSON describes.
#
# It runs on both engines and under `--target=js`, where it is what the RPC
# stub encodes its arguments with. (The browser could use its own JSON.parse
# through `use JS`; one implementation on both sides is one thing to be wrong.)


# ---------- writing ----------

sub json-escape(Str $s --> Str) is export {
    my $out = $s.trans(['\\', '"', "\n", "\r", "\t", "\b", "\f"]
                    => ['\\\\', '\\"', '\\n', '\\r', '\\t', '\\b', '\\f']);
    # The control characters below 0x20 that have no short escape, and the two
    # line separators, which are legal in JSON but not in a JavaScript string
    # literal — a page embeds this text in a <script>.
    $out.=subst(/<[\x00..\x07\x0b\x0e..\x1f\x2028\x2029]>/, { sprintf('\u%04x', $/.Str.ord) }, :g);
    # `</script>` inside the embedded replay log would close the tag.
    $out.subst('</', '<\\/', :g);
}

multi sub to-json(Nil     --> Str) is export { 'null' }
multi sub to-json(Any:U   --> Str) is export { 'null' }
multi sub to-json(Bool:D $b --> Str) is export { $b ?? 'true' !! 'false' }
multi sub to-json(Int:D  $i --> Str) is export { $i.Str }
multi sub to-json(Rat:D  $r --> Str) is export { $r.Num.Str }
multi sub to-json(Num:D  $n --> Str) is export { $n == $n.Int ?? $n.Int.Str !! $n.Str }
multi sub to-json(Str:D  $s --> Str) is export { '"' ~ json-escape($s) ~ '"' }
multi sub to-json(Positional:D $a --> Str) is export { '[' ~ $a.map({ to-json($_) }).join(',') ~ ']' }
multi sub to-json(Associative:D $h --> Str) is export {
    '{' ~ $h.keys.sort.map({ '"' ~ json-escape($_.Str) ~ '":' ~ to-json($h{$_}) }).join(',') ~ '}'
}
multi sub to-json(Pair:D $p --> Str) is export { '{"' ~ json-escape($p.key.Str) ~ '":' ~ to-json($p.value) ~ '}' }
multi sub to-json(Any:D  $x --> Str) is export { to-json($x.Str) }

# ---------- reading ----------

class X::JSON is Exception {
    has Str $.reason;
    has Int $.at;
    method message() { "JSON: $!reason at character $!at" }
}

#| Parse JSON text. Objects become Hashes, arrays Arrays, `null` Nil.
sub from-json(Str $text) is export {
    my @c = $text.comb;
    my $i = 0;

    sub fail-at(Str $why) { die X::JSON.new(reason => $why, at => $i) }
    sub ws() { $i++ while $i < @c && @c[$i] eq ' ' | "\t" | "\n" | "\r" }
    sub lit(Str $word, $value) {
        fail-at("expected $word") unless $text.substr($i, $word.chars) eq $word;
        $i += $word.chars;
        $value;
    }
    sub string() {
        fail-at('expected a string') unless @c[$i] eq '"';
        $i++;
        my $out = '';
        while $i < @c && @c[$i] ne '"' {
            if @c[$i] eq '\\' {
                $i++;
                my $e = @c[$i++];
                $out ~= $e eq 'n' ?? "\n" !! $e eq 't' ?? "\t" !! $e eq 'r' ?? "\r"
                     !! $e eq 'b' ?? "\b" !! $e eq 'f' ?? "\f"
                     !! $e eq 'u' ?? do { my $h = $text.substr($i, 4); $i += 4; chr(:16($h)) }
                     !! $e;
            }
            else { $out ~= @c[$i++] }
        }
        fail-at('unterminated string') unless $i < @c;
        $i++;
        $out;
    }
    sub number() {
        my $b = $i;
        $i++ if @c[$i] eq '-';
        $i++ while $i < @c && @c[$i] ~~ /<[0..9]>/;
        my $float = False;
        if $i < @c && @c[$i] eq '.' { $float = True; $i++; $i++ while $i < @c && @c[$i] ~~ /<[0..9]>/ }
        if $i < @c && @c[$i] eq 'e' | 'E' {
            $float = True; $i++;
            $i++ if $i < @c && (@c[$i] eq '+' | '-');
            $i++ while $i < @c && @c[$i] ~~ /<[0..9]>/;
        }
        my $lex = $text.substr($b, $i - $b);
        fail-at('expected a number') unless $lex.chars;
        $float ?? $lex.Num !! $lex.Int;
    }
    sub value() {
        ws();
        fail-at('unexpected end of input') unless $i < @c;
        given @c[$i] {
            when '{' {
                $i++;
                my %h;
                ws();
                if @c[$i] eq '}' { $i++; return %h }
                loop {
                    ws();
                    my $k = string();
                    ws();
                    fail-at("expected ':'") unless @c[$i] eq ':';
                    $i++;
                    %h{$k} = value();
                    ws();
                    if    @c[$i] eq ',' { $i++ }
                    elsif @c[$i] eq '}' { $i++; last }
                    else { fail-at("expected ',' or '}'") }
                }
                %h;
            }
            when '[' {
                $i++;
                my @a;
                ws();
                if @c[$i] eq ']' { $i++; return @a }
                loop {
                    @a.push: value();
                    ws();
                    if    @c[$i] eq ',' { $i++ }
                    elsif @c[$i] eq ']' { $i++; last }
                    else { fail-at("expected ',' or ']'") }
                }
                @a;
            }
            when '"' { string() }
            when 't' { lit('true', True) }
            when 'f' { lit('false', False) }
            when 'n' { lit('null', Nil) }
            default  { number() }
        }
    }

    my $v = value();
    ws();
    fail-at('trailing text') if $i < @c;
    $v;
}
# Webraku::Client — the same builders, in a browser.
#
# This file only ever runs under `rakupp --target=js`. It installs a hook into
# Webraku::HTML so that building an element also makes (or adopts) a DOM node,
# and it provides the reconcile pass that writes changed properties back into
# the page after every event turn.
#
# Two modes:
#   create   — the element gets a fresh DOM node. Used for anything the page
#              did not already contain.
#   hydrate  — the element ADOPTS the next child of the open parent. Because the
#              server built its HTML from this same code and the same data, the
#              walk lines up; when a tag does not match, the node is replaced and
#              the mismatch is reported rather than hidden.
#
# There is no virtual DOM. An element is retained, its writable properties are
# compared with what the DOM currently shows, and only the differences are
# written. The one place a tree is diffed is `render-list`, where a list of
# children is replaced.


use js;




my $DOC       = JS.document;
my @LIVE;                    # every element that may need reconciling
my $HYDRATING = False;
my @HCURSOR;                 # per open parent: the next existing child to adopt
my $PENDING   = False;       # a reconcile is already queued for this turn

#| Every element built so far, in build order. The bundle's hydration check
#| compares this against the server's HTML.
sub live-elements() is export { @LIVE }

# ---------- making and adopting nodes ----------

#| Where a child node actually belongs. For a <table> the browser keeps rows in
#| a <tbody> it inserted itself, so appending a <tr> to the table directly would
#| put it after that body rather than in it.
sub child-host($node, Str $childTag) {
    return $node unless $childTag eq 'tr';
    return $node unless $node<tagName>.Str.lc eq 'table';
    $node.querySelector('tbody') // $node;
}

sub apply-attrs(Element $el) {
    for $el.attrs.kv -> $k, $v {
        next if $v ~~ Bool && !$v;
        next unless $v.defined;
        $el.node.setAttribute($k, $v ~~ Bool ?? '' !! $v.Str);
        $el.applied-attrs{$k} = $v;
    }
}

sub apply-text(Element $el) {
    if $el.text.defined {
        $el.node<textContent> = $el.text;
        $el.applied-text = $el.text;
    }
}

# The hook Webraku::HTML calls for every element it builds.
sub make-node(Element $el) {
    my $parent = current-parent();
    if $HYDRATING && $parent ~~ Element:D && $parent.node {
        # The candidate is walked as a SIBLING CHAIN, not indexed out of
        # `.children`: that is an HTMLCollection in a browser but crosses to Raku
        # as a copied Array from anything array-like, and the two do not index
        # alike. `firstElementChild` and `nextElementSibling` are plain
        # properties answering one node, and behave the same everywhere.
        my $cand = @HCURSOR ?? @HCURSOR[*-1] !! Nil;
        # A browser's HTML parser inserts a <tbody> that the markup never wrote,
        # so a <tr> built as a direct child of a <table> meets that instead of
        # the row. Step into it — the rows are its children, and they are what
        # this code is building.
        if $cand && $el.tag eq 'tr' && $cand<tagName>.Str.lc eq 'tbody' {
            $cand = $cand<firstElementChild>;
        }
        @HCURSOR[*-1] = $cand ?? $cand<nextElementSibling> !! Nil if @HCURSOR;
        # No candidate at this position simply means the server did not send a
        # node here — anything built after the first render is in that case — so
        # it is created without comment. Only a candidate of the WRONG TAG is a
        # real mismatch, and that one is reported.
        if !$cand {
            $el.node = $DOC.createElement($el.tag);
            apply-attrs($el); apply-text($el);
            child-host($parent.node, $el.tag).appendChild($el.node);
            @LIVE.push: $el;
            return $el;
        }
        if $cand<tagName>.Str.lc eq $el.tag.lc {
            $el.node = $cand;
            # Adopted: the DOM already shows what the server rendered, so record
            # that as applied and write nothing. Writing it anyway would be
            # correct but would touch every node on load.
            $el.applied-text = $el.text if $el.text.defined;
            $el.applied-attrs{$_} = $el.attrs{$_} for $el.attrs.keys;
            @LIVE.push: $el;
            return $el;
        }
        # The page is not what this code would have built. Say so — a silent
        # repaint here is how a hydration bug stays hidden for months — and
        # carry on by building the node fresh.
        JS.console.warn("webraku: hydration mismatch — the page has <{$cand<tagName>.Str.lc}> where this code builds <{$el.tag}>; the node was replaced");
        $el.node = $DOC.createElement($el.tag);
        apply-attrs($el); apply-text($el);
        $parent.node.replaceChild($el.node, $cand);
        @LIVE.push: $el;
        return $el;
    }
    $el.node = $DOC.createElement($el.tag);
    apply-attrs($el);
    apply-text($el);
    child-host($parent.node, $el.tag).appendChild($el.node) if $parent ~~ Element:D && $parent.node;
    @LIVE.push: $el;
    $el;
}

# Webraku::HTML pushes an element onto its own stack for the duration of a
# builder block; the hydration cursor follows it, one entry per open parent, so
# that each level adopts its own children rather than the root's.
sub scope-in(Element $e)  { @HCURSOR.push: ($HYDRATING && $e.node) ?? $e.node<firstElementChild> !! Nil }
sub scope-out(Element $)  { @HCURSOR.pop }

# ---------- events ----------

#| Attach one DOM listener. Webraku::HTML calls this the first time an element's
#| event Supply is asked for — which is when `whenever $b.clicks` evaluates it,
#| before the enclosing `react` starts waiting and never returns.
sub listen(Element $el, Str $name) is export {
    return unless $el.node;
    my $sup = $el.supplier($name);
    $el.node.addEventListener($name, -> $ev {
        # A submit inside a form would navigate away; a page that handles the
        # event does not want that.
        $ev.preventDefault if $name eq 'submit';
        $sup.emit($ev);
        schedule-reconcile();
    });
    $el.listened = True;
}

# ---------- reconcile ----------

#| Write every changed property into the DOM. Cheap: one comparison per live
#| element, and a DOM write only where something actually differs.
sub reconcile() is export {
    for @LIVE -> $el {
        next unless $el.node;
        if $el.text.defined && (!$el.applied-text.defined || $el.text ne $el.applied-text) {
            $el.node<textContent> = $el.text;
            $el.applied-text = $el.text;
        }
        for $el.attrs.kv -> $k, $v {
            next if $el.applied-attrs{$k}:exists && $el.applied-attrs{$k} eqv $v;
            if ($v ~~ Bool && !$v) || !$v.defined {
                $el.node.removeAttribute($k);
            }
            else {
                $el.node.setAttribute($k, $v ~~ Bool ?? '' !! $v.Str);
                # `value` on an input is a PROPERTY: the attribute only sets the
                # default, so typing into the field then ignores it.
                $el.node<value> = $v.Str if $k eq 'value';
            }
            $el.applied-attrs{$k} = $v;
        }
    }
}

#| Queue one reconcile for the end of this event turn. Several handlers firing
#| for the same event then cost one pass, not one each.
sub schedule-reconcile() is export {
    return if $PENDING;
    $PENDING = True;
    JS.queueMicrotask(-> { $PENDING = False; reconcile() });
}

# ---------- lists ----------

#| Replace the children of `$parent` with what `&body` builds, and put the new
#| nodes in the page. This is the one place a tree is rebuilt rather than
#| patched: a list whose items come and go.
#|
#|     render-list $ul, { li .text, :key(.id) for @todos }
sub render-list(Element $parent, &body) is export {
    # Every element in the old subtree leaves the document, so it must leave
    # @LIVE too — otherwise reconcile keeps writing into detached nodes, and the
    # list grows without bound on a page that re-renders often.
    my @dead;
    sub collect(Element $e) { @dead.push: $e; collect($_) for $e.kids.grep(Element) }
    collect($_) for $parent.kids.grep(Element);
    my %dead = @dead.map({ $_.WHICH => True }).Hash;
    @LIVE = @LIVE.grep({ !%dead{$_.WHICH} }).Array;

    # The FIRST draw of a parent the server already filled adopts what is there;
    # clearing it would throw away exactly what hydration is for, and every child
    # would then report a mismatch against a parent that had just been emptied.
    # Every later draw clears and rebuilds.
    $parent.node<innerHTML> = '' if $parent.drawn || !$HYDRATING;
    $parent.drawn = True;
    $parent.kids = [];
    $parent.text = Str;
    $parent.applied-text = Str;
    with-parent($parent, &body);
    reconcile();
    $parent;
}

# ---------- sources the framework hands out ----------

#| A Supply that emits every `$seconds`. `Supply.interval` works here too; this
#| one also schedules a reconcile, so a `whenever` body that changes an element
#| reaches the page without saying so.
sub every(Real $seconds --> Supply) is export {
    supply {
        whenever Supply.interval($seconds) -> $n { emit $n; schedule-reconcile() }
    }
}

#| A Supply that emits once, after `$seconds`.
sub after(Real $seconds --> Supply) is export {
    supply {
        whenever Promise.in($seconds) { emit True; schedule-reconcile(); done }
    }
}

# ---------- mounting ----------

#| Build the page under `$root` and bring it to life. `$hydrate` adopts the
#| nodes already there instead of creating new ones.
sub mount(&body, :$selector = 'body', Bool :$hydrate = False) is export {
    my $rootnode = $selector eq 'body' ?? $DOC<body> !! $DOC.querySelector($selector);
    die "webraku: no element matches '$selector'" unless $rootnode;
    my $root = Element.new(tag => $selector eq 'body' ?? 'body' !! 'div');
    $root.node = $rootnode;
    $HYDRATING = $hydrate;
    webraku-set-browser(True);
    webraku-element-hook(&make-node);
    webraku-scope-hook(&scope-in, &scope-out);
    webraku-listen-hook(&listen);
    # A handler that awaits a server call changes the page after its event turn
    # is over, so the reconcile that turn scheduled has already run. A microtask
    # queued when the answer arrives would run too early as well — before the
    # caller's own continuation — so this one is a task, which runs after every
    # continuation the answer releases.
    webraku-rpc-hook({ JS.setTimeout(-> { reconcile() }, 0) });
    # A page body ends in a `react`, and a `react` in a browser never returns —
    # it is the page, for as long as the page is open — and a body that calls an
    # `is server` sub suspends at its first `await`. So there is no moment "after
    # the build" to hook, and `$HYDRATING` is never turned off: whether a builder
    # adopts or creates is decided per element, by whether the walk still has a
    # node at that position. A node the server did not send has no candidate, and
    # is created. That is self-correcting, where a timer was a race — it fired at
    # the first await, and the whole page was built a second time beneath the
    # first.
    schedule-reconcile();
    with-parent($root, &body);
    $root;
}

# ---------- routes, in the browser ----------
#
# The application's `page` calls run here too — the bundle carries the whole
# program — so the browser ends up with the same table the server has, built by
# the same statements. `api` and `static` are the server's business and are
# accepted and ignored, so that a program need not know which half is reading it.

my @ROUTES;

sub page(Str $pattern, &body, Str :$title = 'Webraku') is export {
    @ROUTES.push: Route.new(kind => 'page', :$pattern, segments => split-path($pattern), :&body, :$title);
}
sub api(Str $pattern, &body) is export { }
sub static(Str $prefix, Str $dir) is export { }
sub stylesheet(Str $css) is export { }

#| The bundle's last statement. Find the page this URL names, replay the log the
#| server embedded, and hydrate the tree the server sent.
sub webraku-hydrate() is export {
    webraku-load-replay();
    my $path = JS.location<pathname>.Str || '/';
    my ($route, %params) = match-route(@ROUTES, $path, kind => 'page');
    without $route {
        JS.console.warn("webraku: no page matches $path; nothing was hydrated");
        return;
    }
    my @args = $route.param-names.map({ %params{$_} });
    # `mount` does NOT return: a page body ends in a `react` that runs for as
    # long as the page is open. Everything that has to happen after the tree is
    # built and before the react starts waiting happens inside `mount`.
    mount({ $route.body.(|@args) }, selector => '#webraku-root', hydrate => True);
}
# Webraku::Rpc — the browser end of `is server`.
#
# A sub marked `is server` has no body in the browser bundle: the bundler
# replaced it with `await webraku-call('name', [args])`, which is this file.
#
# Two ways a call is answered:
#
#   the replay log — every `is server` call the SERVER made while rendering the
#   page is embedded in it, as JSON. The first client render replays that log,
#   so it produces exactly what the server produced, with no network at all.
#   This is what `getServerSideProps` buys, without a second function to write.
#
#   the network — anything the log does not answer is a POST to /_rpc/<name>
#   with the arguments as a JSON array, and the answer is the sub's return
#   value. The log is consumed by the first render, so every later call goes
#   to the network.


use js;


my @REPLAY;
my %USED;

# Webraku::Client installs this, to reconcile after an answer arrives.
my &ANSWERED = -> { };
sub webraku-rpc-hook(&hook) is export { &ANSWERED = &hook }

#| Read the log the server embedded. Called once, before the first render.
sub webraku-load-replay() is export {
    my $tag = JS.document.getElementById('webraku-replay');
    return unless $tag;
    @REPLAY = from-json($tag<textContent> || '[]').list.Array;
}

#| Call a server sub. During hydration the answer comes from the log; after it,
#| over the network.
sub webraku-call(Str $name, @args) is export {
    # The log first, and each entry only once. The server made exactly the calls
    # the first client render makes, so the entries are consumed by it and every
    # later call finds nothing and goes to the network. There is no separate
    # "hydration is over" moment to key on: a page body that awaits has no such
    # moment, which an earlier version of this file learned the hard way.
    my $want = to-json(@args.Array);
    for ^@REPLAY -> $i {
        next if %USED{$i};
        my %e = @REPLAY[$i];
        next unless %e<name> eq $name;
        next unless to-json(%e<args>) eq $want;
        %USED{$i} = True;
        return %e<result>;
    }
    my $res = await JS.fetch('/_rpc/' ~ $name, {
        method  => 'POST',
        headers => { 'content-type' => 'application/json' },
        body    => to-json(@args.Array),
    });
    my $text = await $res.text;
    my %answer = from-json($text);
    die "webraku: $name — %answer<error>" if %answer<error>:exists;
    # The event turn that made this call has long been reconciled, and what the
    # caller does with the answer happens after this returns. So a reconcile is
    # asked for now, to run after that.
    ANSWERED();
    %answer<result>;
}

# ---- the application ----
#!/usr/bin/env rakupp




use deps;

# (a server-only statement was dropped here)

page '/colors', :title('colors'), {
  my $note;
  my $picker;
  my $groups;
  my ($prev-top, $next-top, $prev-bottom, $next-bottom);
  my $active-group;
  my $active-color;
  my $group-info;
  my $range;
  my $pager;
  my $default-group = 'XKCD';
  my $per-page = 100;
  my %page-of;   # group => current page, remembered when switching groups

  my $page = main {

    div :class<intro>, {
      span 'These are the colors in ';
      a( :href<https://raku.land/zef:thundergnat/Color::Names>, 'Color::Names') ~ '.';
      my $src = 'https://github.com/bduggan/bduggan.github.io/blob/master/colors/colors.raku';
      p {
        span 'The '
        a( :href($src), :class<src>, 'source code' )
        span ' (using '
        a :href('https://raku.land/zef:ash/Webraku'), 'Webraku';
        span ') is on GitHub.';
      }
    }

    $groups = span :class<groups>, { };
    hr;

    span 'Click a color to change the background.';
    hr;

    div {
      my $g = $active-group.?text // $default-group;
      $group-info = h3 "group: $g";
      $note = pre '';
      $range = span :class<range>, "showing 1 to { min($per-page, color-count($g)) } of { color-count($g) }";
    }

    div :class<pager-row>, {
      $pager = span :class<pager>, { };
    }

    div :class('step-row top'), {
      $prev-top = button '« prev', :class<prev>;
      $next-top = button 'next »', :class<next>;
    }

    $picker = span :class<picker>, { };

    div :class('step-row bottom'), {
      $prev-bottom = button '« prev', :class<prev>;
      $next-bottom = button 'next »', :class<next>;
    }

    hr;
  }

  sub show-colors {
   my $g = $active-group.text;
   my $p = %page-of{$g} // 1;
   color-page($g, $p, $per-page).map: -> $key {
     my $info = color-info($g, $key);
     my ($name, $bg, $fg) = ($info<name hex contrast>);

     my $b = button :style<<background-color: $bg; color: $fg;>>, $name;
     $b.clicks.tap: {
       .set('class', '') with $active-color;
       $active-color = $b.set('class', 'active');
       $page.set('style', "background-color: $bg; color: $fg");
       $note.text = "set to $bg ($name from $g)";
     }
   }
  }

  # "showing X to Y of Z" for the current page
  sub show-range {
   my $g = $active-group.text;
   my $p = %page-of{$g} // 1;
   my $total = color-count($g);
   my $first = ($p - 1) * $per-page + 1;
   my $last = min($p * $per-page, $total);
   $range.text = "showing $first to $last of $total";
  }

  # a link per page; the current one is highlighted
  sub show-pager {
   my $g = $active-group.text;
   my $p = %page-of{$g} // 1;
   (1 .. page-count($g, $per-page)).map: -> $n {
     my $b = button "$n", :class($n == $p ?? 'page active' !! 'page');
     $b.clicks.tap: { go-to-page($n) }
   }
  }

  sub show-page {
   show-range();
   render-list $pager, { show-pager() }
   render-list $picker, { show-colors() }
  }

  sub go-to-page($n) {
   my $g = $active-group.text;
   return if $n < 1 || $n > page-count($g, $per-page);
   %page-of{$g} = $n;
   show-page();
  }

  sub turn-page($delta) {
   go-to-page((%page-of{$active-group.text} // 1) + $delta);
  }

  sub show-groups {
   color-groups.map: -> $g {
     my $b = button $g, :class<group>;
     unless $active-group {
       $active-group = $b.set('class', 'group active') if $g eq $default-group;
     }
     $b.clicks.tap: {
       .set('class', 'group') with $active-group;
       $active-group = $b.set('class', 'group active');
       $group-info.text = "group: " ~ $active-group.text;
       show-page()
     }
   }
  }

  react {
    whenever after(0) {
      render-list $groups, { show-groups() }
      show-page()
    }
    whenever $prev-top.clicks    { turn-page(-1) }
    whenever $next-top.clicks    { turn-page(1) }
    whenever $prev-bottom.clicks { turn-page(-1) }
    whenever $next-bottom.clicks { turn-page(1) }
  }
}

# (a server-only statement was dropped here)

# ---- mount ----
webraku-hydrate();